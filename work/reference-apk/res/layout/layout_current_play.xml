<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/card_bg_current_play"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp" android:layout_height="68dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <ImageView android:id="@id/imageView"
            android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="12dp"
            android:background="@drawable/bottom_cover_bg" android:clipToOutline="true"
            android:scaleType="centerCrop" android:src="@drawable/ic_no_cover"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        <TextView android:id="@id/textView"
            android:layout_width="0dp" android:layout_height="22dp"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
            android:textSize="14sp" android:textColor="#F1F2F6" android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false" android:gravity="center_vertical"
            android:maxLines="1" android:ellipsize="end"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"
            app:layout_constraintStart_toEndOf="@id/imageView" app:layout_constraintEnd_toStartOf="@id/imageButton"
            app:layout_constraintTop_toTopOf="@id/imageView" />
        <TextView android:id="@id/textView2"
            android:layout_width="0dp" android:layout_height="19dp"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
            android:textSize="11sp" android:textColor="#B5ADBF"
            android:includeFontPadding="false" android:gravity="center_vertical"
            android:maxLines="1" android:ellipsize="end"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp"
            app:layout_constraintStart_toEndOf="@id/imageView" app:layout_constraintEnd_toStartOf="@id/imageButton"
            app:layout_constraintBottom_toBottomOf="@id/imageView" />
        <ImageButton android:id="@id/button"
            android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp"
            android:background="@drawable/bottom_control_bg" android:src="@drawable/ic_baseline_play_arrow_white_24"
            android:tint="#F1F2F6" android:contentDescription="play or pause"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        <ImageButton android:id="@id/imageButton"
            android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="8dp"
            android:background="@drawable/bottom_control_bg" android:src="@drawable/ic_baseline_text_fields_24"
            android:tint="#C0B8CC" android:contentDescription="lrc_display"
            app:layout_constraintEnd_toStartOf="@id/button"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View android:layout_width="0dp" android:layout_height="1dp" android:background="#09FFFFFF"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
