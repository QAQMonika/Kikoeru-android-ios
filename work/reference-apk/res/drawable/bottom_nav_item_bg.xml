<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#18FFFFFF">
    <item>
        <selector>
            <item android:state_selected="true">
                <layer-list>
                    <item android:gravity="bottom|center_horizontal" android:width="20dp" android:height="2dp" android:bottom="5dp">
                        <shape android:shape="rectangle">
                            <solid android:color="#92D5D0" />
                            <corners android:radius="1dp" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
    <item android:id="@android:id/mask" android:drawable="@android:color/white" />
</ripple>
